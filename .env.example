# Discord bot authentication
DISCORD_TOKEN=replace_with_a_new_discord_bot_token

# Google Gemini integration
GEMINI_API_KEY=replace_with_a_new_gemini_api_key

# Clockify integration
CLOCKIFY_API_KEY=replace_with_a_new_clockify_api_key
CLOCKIFY_WORKSPACE_ID=replace_with_your_clockify_workspace_id

# Outbound Discord webhooks
DISCORD_TAGS_WEBHOOK_URL=https://discord.com/api/webhooks/replace_me
DISCORD_APPLICATIONS_WEBHOOK_URL=https://discord.com/api/webhooks/replace_me

# Shared secrets expected in the X-Secret header by the form endpoints
FORM_WEBHOOK_SECRET=replace_with_a_long_random_value
SUBDIVISION_FORM_WEBHOOK_SECRET=replace_with_a_different_long_random_value
